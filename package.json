{
  "name": "@walidsi/pi-herdr-tab-namer",
  "version": "0.1.0",
  "description": "A Pi extension that renames the current Herdr tab from a short summary of the user's first prompt",
  "keywords": [
    "Pi",
    "Herdr",
    "Tab",
    "pi-package",
    "pi-extension"
  ],
  "homepage": "https://github.com/walidsi/pi-herdr-tab-namer#readme",
  "bugs": {
    "url": "https://github.com/walidsi/pi-herdr-tab-namer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walidsi/pi-herdr-tab-namer.git"
  },
  "license": "MIT",
  "author": "Walid Ismail",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./index.ts"
    }
  },
  "files": [
    "index.ts",
    "dist/index.js",
    "dist/index.d.ts",
    "config.json",
    "README.md",
    "LICENSE.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.79.0",
    "@earendil-works/pi-coding-agent": ">=0.79.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}